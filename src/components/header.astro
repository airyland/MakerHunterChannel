---
import { getEnv } from '../lib/env'
import { getSocialProfiles } from '../lib/social'
import voidFile from '../assets/void.png'
import rss from '../assets/rss.svg'
import podcast from '../assets/podcast.svg'
import twitter from '../assets/twitter.svg'
import github from '../assets/github.svg'
import discord from '../assets/discord.svg'
import telegram from '../assets/telegram.svg'
import mastodon from '../assets/mastodon.svg'
import bluesky from '../assets/bluesky.svg'

const { SITE_URL } = Astro.locals
const { channel } = Astro.props

const PODCASRT = getEnv(import.meta.env, Astro, 'PODCASRT')
const staticProxy = getEnv(import.meta.env, Astro, 'STATIC_PROXY') ?? '/static/'

const socialProfiles = getSocialProfiles(import.meta.env, Astro)
const socialIcons = { twitter, github, telegram, discord, mastodon, bluesky }
---

<header id="header">
  <a href={SITE_URL} title={channel?.title}>
    <img
      src={channel?.avatar?.startsWith('http') ? staticProxy + channel?.avatar : voidFile.src}
      alt={channel?.title ? `${channel.title} logo` : 'Site logo'}
      loading="eager"
      class="header-avatar"
    />
  </a>
  <h1 class="header-title">
    <a href={SITE_URL} class="site-title" title={channel?.title}>
      {channel?.title}
    </a>
  </h1>
  <div class="header-icons">
    <a href={`${SITE_URL}rss.xml`} target="_blank" rel="alternate" type="application/rss+xml" title="RSS Feed">
      <img {...rss} alt="RSS" class="social-icon" width="1em" />
    </a>

    {
      PODCASRT && (
        <a href={PODCASRT} target="_blank" title="Podcast">
          <img {...podcast} alt="Podcast" class="social-icon" width="1em" />
        </a>
      )
    }

    {
      socialProfiles.map((profile) => (
        <a href={profile.url} title={profile.title} target="_blank" rel="noopener">
          <img {...socialIcons[profile.key]} alt={profile.label} class="social-icon" width="1em" />
        </a>
      ))
    }
  </div>
</header>

{
  channel?.descriptionHTML && channel?.descriptionHTML.length > 0 && (
    <div class="text-box" id="site-intro" set:html={channel?.descriptionHTML} />
  )
}

<style>
  /* Keep the semantic <h1> visually identical to the previous <div>. */
  .header-title {
    margin: 0;
    font-weight: 600;
    line-height: 1.2;
  }

  #site-intro {
    color: var(--secondary-color);
    background-color: var(--code-background-color);
    word-break: break-word;

    & :global(.emoji) {
      font-style: normal;
      margin-right: 2px;
    }
  }

  .social-icon {
    padding: 4px;
  }

  .header-icons {
    gap: 2px;
  }
</style>
