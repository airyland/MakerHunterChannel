---
import Layout from '../layouts/base.astro'
import Header from '../components/header.astro'
import Item from '../components/item.astro'

const { SITE_URL } = Astro.locals
const { channel, before = true, after = true, noindex = false, title } = Astro.props
const posts = channel.posts ?? []

const beforeCursor = posts[posts.length - 1]?.id
const afterCursor = posts[0]?.id
// const cursor = +Astro.params.cursor
---

<Layout channel={channel} id="main-container" noindex={noindex} title={title}>
  <slot name="header">
    <Header channel={channel} />
  </slot>
  <main class="items">
    {posts.map((post) => <Item post={post} />)}
  </main>

  <nav class="pages-container" aria-label="Pagination">
    {
      before && beforeCursor > 1 ? (
        <a
          href={`${SITE_URL}before/${beforeCursor}`}
          title="Before"
          aria-label={`Older posts, before #${beforeCursor}`}
          class="page"
        >
          Before
        </a>
      ) : (
        <span class="page-placeholder">&nbsp;</span>
      )
    }

    <div class="pages-info"></div>
    {
      after && afterCursor ? (
        <a
          href={`${SITE_URL}after/${afterCursor}`}
          title="After"
          aria-label={`Newer posts, after #${afterCursor}`}
          class="page"
        >
          After
        </a>
      ) : (
        <span class="page-placeholder">&nbsp;</span>
      )
    }
  </nav>
</Layout>
